{
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "template",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": false
      }
    },
    {
      "name": "ci-template",
      "hidden": true,
      "environment": {
        "CI": "true"
      },
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": false
      }
    },
    {
      "name": "ubuntu-cross-compile-template",
      "hidden": true,
      "inherits": [
        "template"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "warnings": {
        "deprecated": true
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_LIBDIR": "lib/CMAKE_SYSTEM_PROCESSOR-linux-gnu",
        "CMAKE_POSITION_INDEPENDENT_CODE": true,
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS Universal",
      "description": "Build for macOS 12.0+ (Universal binary)",
      "inherits": [
        "template"
      ],
      "binaryDir": "${sourceDir}/build_macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "generator": "Xcode",
      "warnings": {
        "deprecated": true
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CODESIGN_IDENTITY": "$penv{CODESIGN_IDENT}",
        "CODESIGN_TEAM": "$penv{CODESIGN_TEAM}"
      }
    },
    {
      "name": "macos-ci",
      "inherits": [
        "macos",
        "ci-template"
      ],
      "displayName": "macOS Universal CI build",
      "description": "Build for macOS 12.0+ (Universal binary) for CI",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    },
    {
      "name": "macos-tsan",
      "inherits": [
        "macos"
      ],
      "displayName": "macOS arm64 TSan",
      "description": "Native macOS Debug tests with ThreadSanitizer",
      "binaryDir": "${sourceDir}/build_macos_tsan",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "ATK_TEST_SANITIZER": "thread",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "Build for Windows x64",
      "inherits": [
        "template"
      ],
      "binaryDir": "${sourceDir}/build_x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "warnings": {
        "deprecated": true
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": ""
      }
    },
    {
      "name": "windows-ci-x64",
      "inherits": [
        "windows-x64",
        "ci-template"
      ],
      "displayName": "Windows x64 CI build",
      "description": "Build for Windows x64 on CI"
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64",
      "description": "Build for Windows ARM64",
      "inherits": [
        "template"
      ],
      "binaryDir": "${sourceDir}/build_arm64",
      "condition": {
        "type": "equals",
        "rhs": "Windows",
        "lhs": "${hostSystemName}"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "ARM64",
      "warnings": {
        "deprecated": true
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": ""
      }
    },
    {
      "name": "windows-ci-arm64",
      "inherits": [
        "windows-arm64",
        "ci-template"
      ],
      "displayName": "Windows ARM64 CI build",
      "description": "Build for Windows ARM64 on CI"
    },
    {
      "name": "ubuntu-x86_64",
      "displayName": "Ubuntu x86_64",
      "description": "Build for Ubuntu x86_64",
      "inherits": [
        "ubuntu-cross-compile-template"
      ],
      "binaryDir": "${sourceDir}/build_x86_64"
    },
    {
      "name": "ubuntu-x86_64-debug",
      "inherits": [
        "ubuntu-x86_64"
      ],
      "displayName": "Ubuntu x86_64 Debug",
      "description": "Local debug build for Ubuntu x86_64",
      "binaryDir": "${sourceDir}/build_x86_64_debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ubuntu-ci-x86_64",
      "inherits": [
        "ubuntu-x86_64",
        "ci-template"
      ],
      "displayName": "Ubuntu x86_64 CI build",
      "description": "Build for Ubuntu x86_64 on CI"
    },
    {
      "name": "ubuntu-x86_64-asan-ubsan-lsan",
      "inherits": [
        "ubuntu-x86_64-debug"
      ],
      "displayName": "Ubuntu x86_64 ASan UBSan LSan",
      "description": "Linux Clang Debug tests with Address, UndefinedBehavior, and Leak Sanitizers",
      "binaryDir": "${sourceDir}/build_x86_64_asan_ubsan_lsan",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "ATK_TEST_SANITIZER": "address-undefined-leak",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "ubuntu-x86_64-tsan",
      "inherits": [
        "ubuntu-x86_64-debug"
      ],
      "displayName": "Ubuntu x86_64 TSan",
      "description": "Linux Clang Debug tests with ThreadSanitizer",
      "binaryDir": "${sourceDir}/build_x86_64_tsan",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "ATK_TEST_SANITIZER": "thread",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "ubuntu-x86_64-rtsan",
      "inherits": [
        "ubuntu-x86_64-debug"
      ],
      "displayName": "Ubuntu x86_64 RTSan",
      "description": "Linux Clang Debug tests with RealtimeSanitizer",
      "binaryDir": "${sourceDir}/build_x86_64_rtsan",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "ATK_TEST_SANITIZER": "realtime",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos",
      "configurePreset": "macos",
      "displayName": "macOS Universal Debug",
      "description": "macOS build for Universal architectures",
      "configuration": "Debug"
    },
    {
      "name": "macos-relwithdebinfo",
      "configurePreset": "macos",
      "displayName": "macOS Universal RelWithDebInfo",
      "description": "macOS build for Universal architectures (RelWithDebInfo configuration)",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-ci",
      "configurePreset": "macos-ci",
      "displayName": "macOS Universal CI",
      "description": "macOS CI build for Universal architectures",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-tsan",
      "configurePreset": "macos-tsan",
      "displayName": "macOS arm64 TSan",
      "description": "Build ThreadSanitizer tests",
      "configuration": "Debug",
      "targets": [
        "tests"
      ]
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "displayName": "Windows x64",
      "description": "Windows build for x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "displayName": "Windows x64 Debug",
      "description": "Windows build for x64 (Debug configuration)",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "displayName": "Windows x64 Release",
      "description": "Windows build for x64 (full Release configuration)",
      "configuration": "Release"
    },
    {
      "name": "windows-ci-x64",
      "configurePreset": "windows-ci-x64",
      "displayName": "Windows x64 CI",
      "description": "Windows CI build for x64 (RelWithDebInfo configuration)",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "displayName": "Windows ARM64",
      "description": "Windows build for ARM64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-ci-arm64",
      "configurePreset": "windows-ci-arm64",
      "displayName": "Windows ARM64 CI",
      "description": "Windows CI build for ARM64 (RelWithDebInfo configuration)",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ubuntu-x86_64",
      "configurePreset": "ubuntu-x86_64",
      "displayName": "Ubuntu x86_64",
      "description": "Ubuntu build for x86_64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ubuntu-x86_64-debug",
      "configurePreset": "ubuntu-x86_64-debug",
      "displayName": "Ubuntu x86_64 Debug",
      "description": "Ubuntu local debug build for x86_64",
      "configuration": "Debug"
    },
    {
      "name": "ubuntu-ci-x86_64",
      "configurePreset": "ubuntu-ci-x86_64",
      "displayName": "Ubuntu x86_64 CI",
      "description": "Ubuntu CI build for x86_64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ubuntu-x86_64-asan-ubsan-lsan",
      "configurePreset": "ubuntu-x86_64-asan-ubsan-lsan",
      "displayName": "Ubuntu x86_64 ASan UBSan LSan",
      "description": "Build AddressSanitizer, UndefinedBehaviorSanitizer, and LeakSanitizer tests",
      "configuration": "Debug",
      "targets": [
        "tests"
      ]
    },
    {
      "name": "ubuntu-x86_64-tsan",
      "configurePreset": "ubuntu-x86_64-tsan",
      "displayName": "Ubuntu x86_64 TSan",
      "description": "Build ThreadSanitizer tests",
      "configuration": "Debug",
      "targets": [
        "tests"
      ]
    },
    {
      "name": "ubuntu-x86_64-rtsan",
      "configurePreset": "ubuntu-x86_64-rtsan",
      "displayName": "Ubuntu x86_64 RTSan",
      "description": "Build RealtimeSanitizer tests",
      "configuration": "Debug",
      "targets": [
        "tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "macos-tsan-audiographmt",
      "configurePreset": "macos-tsan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      },
      "filter": {
        "include": {
          "name": "(ParallelExecutionTest|ParallelRenderSequenceTest|SubgraphExtractorTest|DagPartitionerParallelTest|WorkerPinningTest)"
        }
      }
    },
    {
      "name": "ubuntu-x86_64-asan-ubsan-lsan-audiographmt",
      "configurePreset": "ubuntu-x86_64-asan-ubsan-lsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "filter": {
        "include": {
          "name": "(ParallelExecutionTest|ParallelRenderSequenceTest|SubgraphExtractorTest|DagPartitionerParallelTest|WorkerPinningTest)"
        }
      }
    },
    {
      "name": "ubuntu-x86_64-tsan-audiographmt",
      "configurePreset": "ubuntu-x86_64-tsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      },
      "filter": {
        "include": {
          "name": "(ParallelExecutionTest|ParallelRenderSequenceTest|SubgraphExtractorTest|DagPartitionerParallelTest|WorkerPinningTest)"
        }
      }
    },
    {
      "name": "ubuntu-x86_64-rtsan-audiographmt",
      "configurePreset": "ubuntu-x86_64-rtsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "RTSAN_OPTIONS": "halt_on_error=1"
      },
      "filter": {
        "include": {
          "name": "(ParallelExecutionTest|ParallelRenderSequenceTest|SubgraphExtractorTest|DagPartitionerParallelTest|WorkerPinningTest)"
        }
      }
    }
  ]
}